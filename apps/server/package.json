{
  "name": "@talaba/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker-main.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker-main.js",
    "build": "node build.mjs",
    "migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@talaba/shared": "workspace:*",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "file-type": "22.2.0",
    "fontkit": "2.0.4",
    "ipaddr.js": "2.5.0",
    "jszip": "3.10.2",
    "node-html-parser": "9.0.4",
    "papaparse": "5.7.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "postgres": "3.4.9",
    "pptxgenjs": "4.0.1",
    "undici": "8.12.2",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/fontkit": "2.0.9",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
