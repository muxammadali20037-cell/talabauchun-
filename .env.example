# TALABA AI — server configuration (apps/server). Copy to .env and fill in.
# Never commit real values. Everything secret lives in the server environment only.

# ── core ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
# Public HTTPS address of this server. Telegram requires HTTPS for the webhook and the Mini App.
PUBLIC_BASE_URL=https://talaba.example.uz
DATABASE_URL=postgres://talaba:CHANGE_ME@db:5432/talaba
DATABASE_POOL_MAX=20
# Private file storage (uploads, exports). Must NOT be served publicly; downloads use short-lived signed links.
STORAGE_DIR=/var/lib/talaba/storage
# Random 32+ characters (openssl rand -hex 32). Signs download links and invite tokens.
SIGNING_SECRET=
# Run database migrations when the API starts (or run `pnpm --filter @talaba/server migrate` in the deploy step)
MIGRATE_ON_START=true
LOG_LEVEL=info

# ── Telegram (BotFather) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random 1–256 chars [A-Za-z0-9_-]; sent by Telegram in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# webhook (production) or polling (local development without HTTPS)
TELEGRAM_MODE=webhook
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_INITDATA_MAX_AGE_SEC=3600
SESSION_TTL_HOURS=12
# Comma-separated numeric Telegram user ids with platform-admin rights
ADMIN_TELEGRAM_IDS=
# Admin changes need a sign-in younger than this (minutes)
ADMIN_FRESH_SESSION_MIN=15
# Optional: chat id (user or group) that receives a copy of every support ticket
SUPPORT_CHAT_ID=
# Optional external pages; otherwise the built-in summaries in the Mini App are shown
TERMS_URL=
PRIVACY_URL=

# ── AI (Anthropic Claude) — optional; without it the extractive (no-AI) mode runs ──
AI_PROVIDER=none
ANTHROPIC_API_KEY=
# AI_BASE_URL=https://your-gateway.example/anthropic
AI_MODEL_STRONG=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-5-5
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2

# ── Semantic search (optional) ─────────────────────────────────────
EMBEDDINGS_PROVIDER=none
VOYAGE_API_KEY=
EMBEDDINGS_MODEL=voyage-3.5

# ── Document processing (system packages: tesseract-ocr + uzb/uzb_cyrl/rus/eng, poppler-utils, libreoffice, fonts-liberation) ──
OCR_LANGS=uzb+uzb_cyrl+rus+eng
TESSERACT_BIN=tesseract
PDFTOPPM_BIN=pdftoppm
LIBREOFFICE_BIN=soffice
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=800

# ── Worker ─────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_LEASE_SEC=120

# ── Payments (Telegram Stars). Turn on only after plans have prices and the payment tests pass. ──
PAYMENTS_ENABLED=false

# ── Operations ─────────────────────────────────────────────────────
# Bearer token for GET /metrics (Prometheus). Empty = platform admins only.
METRICS_TOKEN=
# Log of completed account deletions, OUTSIDE the backed-up storage directory
DELETION_LOG_PATH=/var/lib/talaba/deletion-log.jsonl
BACKUP_RETENTION_DAYS=14

# Development only (refused when NODE_ENV=production)
DEV_AUTH_ENABLED=false
MINIAPP_DIST_DIR=../miniapp/dist
